{
  "model": "Hy4",
  "architecture_file": "../src/models/hunyuan/config.json",
  "description": "Hy4-10T 纯 EP 分析：2048 路由专家 ÷ EP64，稠密参数每 rank 全复制。世界 1024 卡 = EP64 x DP16（DP 维不参与分片）。",
  "architecture": {
    "n_routed_experts": 2048,
    "num_experts_per_tok": 64,
    "moe_intermediate_size": 3456,
    "output_all_positions": true
  },
  "max_seq_len": 4096,
  "dtype": "bf16",
  "training": {
    "num_devices": 1024,
    "groups": {
      "dense": {"device": "gpu", "shards": 1, "optimizer": "adamw", "master_dtype": "none"},
      "expert": {"device": "gpu", "shards": 64, "optimizer": "adamw", "master_dtype": "none"},
      "buffer": {"device": "gpu", "shards": 1, "optimizer": "adamw", "master_dtype": "none", "trainable": false}
    }
  }
}
