{
  "model": "Hy4",
  "architecture_file": "../src/models/hunyuan/config.json",
  "description": "Hy4-10T 纯 FSDP 分析：全部参数（含专家）÷ DP1024，等价 ZeRO-3 静态切分。",
  "architecture": {
    "n_routed_experts": 2048,
    "num_experts_per_tok": 64,
    "moe_intermediate_size": 3456,
    "output_all_positions": true
  },
  "max_seq_len": 4096,
  "dtype": "bf16",
  "training": {
    "num_devices": 1024,
    "groups": {
      "dense": {"device": "gpu", "shards": 1024, "optimizer": "adamw", "master_dtype": "none"},
      "expert": {"device": "gpu", "shards": 1024, "optimizer": "adamw", "master_dtype": "none"},
      "buffer": {"device": "gpu", "shards": 1024, "optimizer": "adamw", "master_dtype": "none", "trainable": false}
    }
  }
}
